# Weights & Biases / CoreWeave serverless inference
WANDB_API_KEY=
WANDB_PROJECT=thilakshekharshriyan/VideoHack
WANDB_MODEL=OpenPipe/Qwen3-14B-Instruct
WEAVE_ENABLED=1

# VAST Builders Challenge — team VSS retrieval (JWT login)
# Copy INGRESS_URL, USERNAME, PASSWORD from the VM /config/*.config
INGRESS_URL=
USERNAME=
PASSWORD=

# Shared CoreWeave GPU NIMs (OpenAI-compatible /v1/chat/completions, /v1/embeddings)
# GPU_HOST is public event infra. Never commit GPU_BEARER_TOKEN.
GPU_HOST=166.19.38.112
GPU_BEARER_TOKEN=
COSMOS3_REASON_URL=
YOLO_URL=
COSMOS_EMBED1_URL=
CANARY_1B_URL=
COSMOS3_REASON_MODEL=nvidia/cosmos3-reason
COSMOS_EMBED1_MODEL=nvidia/cosmos-embed1

# Optional: push local uploads into the team VSS pipeline (off by default)
VAST_UPLOAD=0

# NVIDIA VSS blueprint (Cosmos Reason captions) if not using challenge NIMs
NVIDIA_VSS_URL=
NVIDIA_API_KEY=
NVIDIA_COSMOS_MODEL=cosmos-reason2

# NVIDIA NIM cloud fallback
NVIDIA_NIM_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/cosmos-reason1-7b
NVIDIA_EMBED_URL=
NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# Legacy direct search URL (INGRESS_URL is preferred)
VAST_SEARCH_URL=
VAST_API_KEY=

# Local API
PORT=8787
